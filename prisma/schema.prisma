// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum UserRole {
  user
  admin
}

enum AuthProvider {
  local
  google
  hybrid
}

enum UnblockRequestStatus {
  pending
  approved
  rejected
}

enum VerificationTokenType {
  email_verification
  password_reset
  email_change
}

model Users {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  firstname String
  lastname  String
  email     String   @unique
  age       Int
  password  String
  authProvider AuthProvider @default(local)
  // Not @unique: MongoDB unique indexes treat every missing googleId as the same
  // null, so the index can't be built once two non-Google users exist (prod has
  // 143). Google sign-in matches users by their unique email instead.
  googleId   String?
  emailVerified Boolean @default(false)
  role      UserRole @default(user)
  isBlocked Boolean  @default(false)
  blockedAt DateTime?
  blockedReason String?
  lastLoginAt DateTime?
  deletedAt DateTime?
  tokenVersion Int @default(0)
  imageUrl  String? @default("https://cyber.comolho.com/static/img/avatar.png")
  expertise Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt


  sentRequests     ConnectionsRequest[] @relation("sentRequests")
  receivedRequests ConnectionsRequest[] @relation("receivedRequests")
  comments         Comment[]
  posts Post[]
  likes    Like[]
  reports  Report[]

  conversationsIds String[] @db.ObjectId
  conversations Conversation[] @relation(fields: [conversationsIds], references: [id])
  messages      Message[]
  aiChatSessions AIChatSession[]
  unblockRequests UnblockRequest[]
  verificationTokens VerificationToken[]
  refreshTokens      RefreshToken[]

  notificationsReceived Notification[] @relation("notificationRecipient")
  notificationsSent     Notification[] @relation("notificationActor")
  savedPosts            SavedPost[]

  @@index([googleId])
}

model VerificationToken {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  userId      String                @db.ObjectId
  tokenHash   String                @unique
  type        VerificationTokenType @default(email_verification)
  expiresAt   DateTime
  createdAt   DateTime              @default(now())
  // Wrong codes entered against this token; it is deleted after MAX_OTP_ATTEMPTS
  attempts    Int?
  // email_change only: the address the code was sent to, applied once the code is confirmed
  pendingEmail String?

  user        Users                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
}

// One per signed-in browser. The cookie holds a random value; only its hash is stored.
// Each use replaces it with a new one in the same family; reusing a replaced one ends the whole family.
model RefreshToken {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  userId       String    @db.ObjectId
  tokenHash    String    @unique
  familyId     String
  // The user's tokenVersion at sign-in: a password change ends the session
  tokenVersion Int       @default(0)
  // Fixed at sign-in and kept by every renewal: the session ends this many days after login
  expiresAt    DateTime
  revokedAt    DateTime?
  // The token that replaced this one; tells a lost renewal response apart from a copied token
  replacedById String?   @db.ObjectId
  createdAt    DateTime  @default(now())

  user         Users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
}

model UnblockRequest {
  id          String               @id @default(auto()) @map("_id") @db.ObjectId
  userId      String               @db.ObjectId
  message     String
  status      UnblockRequestStatus @default(pending)
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  user        Users                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
}

enum RecommendationEventType {
  shown
  saved
  ignored
  interested
}

enum RecommendationPreferenceStatus {
  none
  preferred
  not_preferred
}

enum ConnectionStatus {
  ignored
  interested
  rejected
  accepted
}

model ConnectionsRequest {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  fromUserId  String           @db.ObjectId
  toUserId    String           @db.ObjectId
  status      ConnectionStatus @default(interested)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  fromUser Users @relation("sentRequests", fields: [fromUserId], references: [id] , onDelete: Cascade)
  toUser   Users @relation("receivedRequests", fields: [toUserId], references: [id], onDelete: Cascade)
  notifications Notification[]

  @@unique([fromUserId, toUserId])
  @@index([fromUserId, status])
  @@index([toUserId, status])
}

model Post {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  content   String
  image     String?
  video     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Users mentioned in `content`; resolved from @handles when the post is saved.
  mentionIds  String[] @db.ObjectId
  // Open Graph preview of the first link in `content`: { url, title, description, image, siteName }.
  linkPreview Json?

  userId String @db.ObjectId
  user   Users @relation(fields: [userId], references: [id], onDelete: Cascade)
  comments Comment[]
  likes    Like[]
  reports  Report[]
  notifications Notification[]
  saves    SavedPost[]

  // A repost always points at the root original. Empty `content` = plain repost,
  // otherwise a quote. Self-relations need NoAction on MongoDB, so deletePost
  // cleans reposts up itself.
  repostOfId String? @db.ObjectId
  repostOf   Post?   @relation("Reposts", fields: [repostOfId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reposts    Post[]  @relation("Reposts")

  @@index([repostOfId, userId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model SavedPost {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())

  userId String @db.ObjectId
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String @db.ObjectId
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([userId, createdAt])
}

model Comment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @db.ObjectId
  user   Users @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String @db.ObjectId
  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  reports Report[]
  notifications Notification[]

  mentionIds String[] @db.ObjectId

  // Replies are one level deep: a reply to a reply attaches to the top-level
  // comment. NoAction (self-relation), so deleteComment removes replies itself.
  parentId String?   @db.ObjectId
  parent   Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies  Comment[] @relation("CommentReplies")

  @@index([postId, parentId, createdAt])
  // Deleting a comment deletes its replies
  @@index([parentId])
}
  

model Conversation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  isGroup   Boolean  @default(false)
  name      String?
  image     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participantIds String[] @db.ObjectId
  participants   Users[]  @relation(fields: [participantIds], references: [id])
  
  messages     Message[]

  @@index([participantIds])
}

enum MessageStatus {
  sent
  delivered
  seen
}

model Message {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  text          String?
  image         String?
  file          String?
  originalName  String?
  isDelete      Boolean @default(false)
  deletedById   String[] @db.ObjectId @map("deleteybyid")

  status        MessageStatus @default(sent)

  conversationId String @db.ObjectId
  senderId       String @db.ObjectId
  parentMessageId String? @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Users        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  parentMessage Message?    @relation("Replies", fields: [parentMessageId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies       Message[]   @relation("Replies")

  @@index([conversationId, createdAt])
}

model Like {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  isLiked   Boolean  @default(true)

  userId String @db.ObjectId
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String @db.ObjectId
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([userId, postId])
  @@index([postId])
}

model Report {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  reason    String
  createdAt DateTime @default(now())

  userId String @db.ObjectId
  user   Users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  postId String? @db.ObjectId
  post   Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?  @db.ObjectId
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  // Every post read checks "has the viewer reported it" (userId + postId in the page); reportPost and
  // reportComment check for an earlier report the same way
  @@index([userId, postId])
  @@index([userId, commentId])
}

model AIChatSession {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String   @default("New Chat")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  isDeleted Boolean  @default(false)

  userId    String   @db.ObjectId
  user      Users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  messages  AIChatMessage[]

  @@index([userId, updatedAt])
}

model AIChatMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  role      String   // "user" or "ai"
  text      String
  feedback  Int?     // 1 = helpful, -1 = not helpful (AI messages only)
  feedbackNote String?
  meta      Json?    // AI messages: { question, sources, language, cacheable, error } for feedback learning
  createdAt DateTime @default(now())

  sessionId String   @db.ObjectId
  session   AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model MessageAIReplyHistory {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  userId         String   @db.ObjectId
  targetUserId   String   @db.ObjectId
  conversationId String?  @db.ObjectId
  contextSummary String
  lastMessage    String
  sentReply      String
  tone           String?
  detectedIntent String?
  topReply       String?
  generatedReplies Json?
  createdAt      DateTime @default(now())

  @@index([userId, targetUserId, createdAt])
  @@index([conversationId, createdAt])
}

model MessageAIAskHistory {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @db.ObjectId
  targetUserId String   @db.ObjectId
  question     String
  answer       String
  messages     Json?
  createdAt    DateTime @default(now())

  @@index([userId, targetUserId, createdAt])
}

model RecommendationEvent {
  id              String                  @id @default(auto()) @map("_id") @db.ObjectId
  userId          String                  @db.ObjectId
  candidateUserId String                  @db.ObjectId
  action          RecommendationEventType
  source          String                  @default("smart_connections")
  metadata        Json?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@index([userId, action])
  @@index([userId, candidateUserId])
  @@index([source, createdAt])
}

// Each user's ranked Get Connections list, kept between server restarts so opening the page is one read.
// items holds only ids, scores and reasons; profiles are loaded when the list is shown.
model RecommendationList {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  userId     String    @unique @db.ObjectId
  items      Json
  strategy   String
  computedAt DateTime
  // Set when something relevant changed (profile, connection, feedback): the list is still shown,
  // and recomputed in the background
  staleAt    DateTime?
}

model RecommendationPreference {
  id              String                         @id @default(auto()) @map("_id") @db.ObjectId
  userId          String                         @db.ObjectId
  candidateUserId String                         @db.ObjectId
  status          RecommendationPreferenceStatus @default(none)
  source          String                         @default("smart_connections")
  metadata        Json?
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt

  @@unique([userId, candidateUserId])
  @@index([userId, status])
  @@index([source, updatedAt])
}

enum NotificationType {
  like
  comment
  connection_request
  connection_accepted
  mention
  reply
  repost
}

model Notification {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  type        NotificationType
  isRead      Boolean          @default(false)
  readAt      DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  recipientId String @db.ObjectId
  recipient   Users  @relation("notificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  actorId     String @db.ObjectId
  actor       Users  @relation("notificationActor", fields: [actorId], references: [id], onDelete: Cascade)

  postId      String? @db.ObjectId
  post        Post?   @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId   String?  @db.ObjectId
  comment     Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  connectionRequestId String?             @db.ObjectId
  connectionRequest   ConnectionsRequest? @relation(fields: [connectionRequestId], references: [id], onDelete: Cascade)

  @@index([recipientId, createdAt])
  @@index([recipientId, isRead])
  @@index([actorId, type, postId])
  // Reviewing a connection request removes its notification by this id
  @@index([connectionRequestId])
}
