

DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>/website_db?retryWrites=true&w=majority"
JWT_SECRET_KEY=

FRONTEND_URL=http://localhost:5173

CLOUD_NAME=
CLOUD_KEY=
CLOUD_SECRET=

SMTP_USER=
SMTP_PASS=


PORT=2004

SMTP_FROM=
REDIS_URL=redis://127.0.0.1:6379

LLM_SERVICE_URL=http://localhost:8000
# Required: must equal AGENT_INTERNAL_KEY in WebsiteAgent/.env, or every AI feature is refused
AGENT_INTERNAL_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=


# ── Optional (defaults shown) ────────────────────────────────────────────────
# While rotating JWT_SECRET_KEY, put the old value here so signed-in users aren't logged out
JWT_SECRET_KEY_PREVIOUS=
# Access token lifetime (seconds), and how long a sign-in lasts before logging in again (days)
ACCESS_TOKEN_TTL_SECONDS=900
SESSION_TTL_DAYS=7
# Proxies in front of the server (Render = 1). Wrong values make every visitor share one rate limit
TRUST_PROXY=1
# Error monitoring: paste the project's DSN from sentry.io to turn it on
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
# json (production default) or pretty
LOG_FORMAT=
LOG_LEVEL=info
# Requests per 15 minutes: any route per IP / auth routes per IP / auth routes per email; AI per minute
RATE_LIMIT_GLOBAL_MAX=1000
RATE_LIMIT_AUTH_MAX=30
RATE_LIMIT_PER_EMAIL_MAX=10
RATE_LIMIT_AI_PER_MINUTE=20
# Optional: this API's public address, to keep a free Render instance awake (off by default; uses ~744 of
# the 750 free instance hours a month, so only one free service can stay awake)
KEEPALIVE_URL=
# AI agent time limits (ms): drafting an expertise page / background calls / AI help chat silence
AGENT_EXPERTISE_TIMEOUT_MS=45000
AGENT_BACKGROUND_TIMEOUT_MS=15000
AGENT_CHAT_IDLE_TIMEOUT_MS=30000
